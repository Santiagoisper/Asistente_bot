# =============================================================================
# Ichtys — environment variables
# Copiá este archivo a .env.local (apps/web) y/o .env (raíz) y completá valores.
# NUNCA commitear valores reales. Ver docs/SECURITY.md.
# =============================================================================

# --- Auth (Clerk Organizations) ---
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/dashboard

# --- Database (Neon Postgres + pgvector) ---
# Pooled connection (runtime / serverless)
DATABASE_URL=
# Direct/unpooled connection (migrations)
DATABASE_URL_UNPOOLED=

# --- Storage (Vercel Blob) ---
BLOB_READ_WRITE_TOKEN=

# --- AI / LLM ---
# Cifrado de API keys por organización (obligatorio en prod si usan Ajustes → keys)
ORG_LLM_KEYS_ENCRYPTION_SECRET=
# Proveedores: Anthropic (primario de la plataforma), OpenAI, Google, Groq y GLM
# vía OpenRouter. Google acepta GOOGLE_GENERATIVE_AI_API_KEY o GOOGLE_API_KEY.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=
GROQ_API_KEY=
# OPENROUTER_API_KEY es la clave de GLM (Z.ai), último recurso de la cadena.
OPENROUTER_API_KEY=
# auto = Claude → OpenAI → Gemini → Groq → GLM (salta proveedores sin key).
# NO dejar GLM como único proveedor: LLM_PROVIDER=glm colgaba el chat 300 s hasta
# el timeout de Vercel (briefs/prod-errores.md, causa del incidente de junio).
LLM_PROVIDER=auto
# Modelos por propósito (opcional). Si se omiten, cada proveedor usa su default
# (ver getModelId en packages/llm/provider.ts).
#   Anthropic: TITLE_MODEL · ANSWER_MODEL · SPEC_EXTRACTION_MODEL
#   OpenAI:    OPENAI_TITLE_MODEL · OPENAI_ANSWER_MODEL (o ANSWER_MODEL_OPENAI) ·
#              SPEC_EXTRACTION_MODEL_OPENAI
#   Google:    GOOGLE_TITLE_MODEL (o GEMINI_TITLE_MODEL) · GEMINI_ANSWER_MODEL
#              (o GOOGLE_ANSWER_MODEL) · SPEC_EXTRACTION_MODEL_GEMINI
#   Groq:      GROQ_TITLE_MODEL · GROQ_ANSWER_MODEL · SPEC_EXTRACTION_MODEL_GROQ
#   GLM:       GLM_MODEL es el genérico (sirve para los tres propósitos si no hay
#              override) · GLM_TITLE_MODEL · GLM_ANSWER_MODEL · SPEC_EXTRACTION_MODEL_GLM
# Ejemplo: fijar el modelo del spec/SoA sin tocar código
# SPEC_EXTRACTION_MODEL=claude-opus-5-5
# Precios del medidor de consumo: corrige un precio sin redeploy. Las claves del
# JSON se matchean por PREFIJO del model id y gana la más específica.
# USAGE_PRICE_OVERRIDES_JSON={"glm-5":{"inputPerMTok":0.98,"outputPerMTok":3.08}}
# Embeddings: OpenAI text-embedding-3-small (default si OPENAI_API_KEY), Google
# gemini-embedding-001, o Groq nomic-embed-text-v1_5 (retirado por Groq; último recurso).
# Forzar proveedor: groq | openai | google (opcional)
# EMBEDDING_PROVIDER=openai
# EMBEDDING_MODEL=            # override del modelo; por defecto según proveedor
# EMBEDDING_BASE_URL=         # override del endpoint OpenAI-compatible
# EMBEDDING_BATCH_SIZE=64     # textos por lote al embeber
# EMBEDDING_RETRY_BASE_MS=500 # backoff base ante 429/5xx del proveedor

# --- Rate limiting (Upstash Redis / Vercel KV REST) ---
# Production should configure either KV_* or UPSTASH_* values.
KV_REST_API_URL=
KV_REST_API_TOKEN=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Set to "false" to disable rate limiting (useful for tests and local dev).
# Defaults to enabled (true) when not set.
RATE_LIMIT_ENABLED=true
# Per-endpoint limits (requests per minute per userId). Defaults shown.
RATE_LIMIT_CHAT_PER_MINUTE=30
RATE_LIMIT_UPLOAD_PER_MINUTE=10
RATE_LIMIT_HISTORY_PER_MINUTE=100
RATE_LIMIT_CITATIONS_PER_MINUTE=100

# --- Internal endpoints ---
# Off by default. Must be explicitly set to true server-side.
ENABLE_INTERNAL_RAG_ANSWER_TEST=false

# --- Cron (recuperación de documentos trabados) ---
# Vercel Cron lo inyecta como Authorization: Bearer ${CRON_SECRET}.
CRON_SECRET=
# Minutos en status='processing' antes de considerarlo trabado (default 60).
STUCK_DOCS_THRESHOLD_MINUTES=60

# --- PHI field-level encryption (Fase 0 — obligatorio antes de módulo sujetos) ---
# 32 bytes as 64-char hex. Generate: node scripts/generate-phi-key.mjs
# NEVER commit real keys. Rotate per docs/compliance/BACKUP-AND-DR.md
PHI_ENCRYPTION_KEY=

# --- Demo tenant (pitch / smoke test mock T2D) ---
# pnpm demo:setup — requires DATABASE_URL + OPENAI_API_KEY
# DEMO_CLERK_ORG_ID=org_...  (optional, default Ichtys Dev org)

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Runtime / build ---
# VERCEL y NODE_ENV las inyecta la plataforma; no hace falta definirlas.
# WS_NO_BUFFER_UTIL / WS_NO_UTF_8_VALIDATE: flags de `ws` (driver de Neon sobre
# WebSocket) para silenciar sus warnings; sólo en local/CI si molestan.
# WS_NO_BUFFER_UTIL=1
# WS_NO_UTF_8_VALIDATE=1
